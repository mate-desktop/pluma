#: pluma/pluma-io-error-message-area.c:205
#, c-format
msgid "Could not find the file %s."
msgstr "ບໍ່ພົບໄຟລ໌ %s."

#: pluma/pluma-io-error-message-area.c:207
#: pluma/pluma-io-error-message-area.c:246
#: pluma/pluma-io-error-message-area.c:253
msgid "Please check that you typed the location correctly and try again."
msgstr "ກະລຸນາກວດສອບວ່າທ່ານພິມທີ່ຢູ່ຖືກຕ້ອງຫຼືບໍ່ ແລ້ວລອງໃໝ່ອີກຄັ້ງ."

#. Translators: %s is a URI scheme (like for example http:, ftp:, etc.)
#: pluma/pluma-io-error-message-area.c:222
#, c-format
msgid "pluma cannot handle %s locations."
msgstr "pluma ບໍ່ຮອງຮັບທີ່ຢູ່ %s."

#: pluma/pluma-io-error-message-area.c:228
msgid "pluma cannot handle this location."
msgstr "pluma ບໍ່ຮອງຮັບທີ່ຢູ່ນີ້."

#: pluma/pluma-io-error-message-area.c:236
msgid "The location of the file cannot be mounted."
msgstr "ບໍ່ສາມາດເມົາທ໌ (mount) ທີ່ຢູ່ຂອງໄຟລ໌ໄດ້."

#: pluma/pluma-io-error-message-area.c:240
msgid "The location of the file cannot be accessed because it is not mounted."
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງທີ່ຢູ່ຂອງໄຟລ໌ໄດ້ ເພາະຍັງບໍ່ໄດ້ເມົາທ໌."

#: pluma/pluma-io-error-message-area.c:244
#, c-format
msgid "%s is a directory."
msgstr "%s ແມ່ນໄດເຣັກທໍຣີ."

#: pluma/pluma-io-error-message-area.c:251
#, c-format
msgid "%s is not a valid location."
msgstr "%s ແມ່ນທີ່ຢູ່ທີ່ບໍ່ຖືກຕ້ອງ."

#: pluma/pluma-io-error-message-area.c:281
#, c-format
msgid ""
"Host %s could not be found. Please check that your proxy settings are "
"correct and try again."
msgstr "ບໍ່ພົບໂຮສຕ໌ %s. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີ (proxy) ຂອງທ່ານ."

#: pluma/pluma-io-error-message-area.c:294
msgid ""
"Hostname was invalid. Please check that you typed the location correctly and "
"try again."
msgstr "ຊື່ໂຮສຕ໌ບໍ່ຖືກຕ້ອງ. ກະລຸນາກວດສອບການພິມທີ່ຢູ່ຂອງທ່ານ."

#: pluma/pluma-io-error-message-area.c:302
#, c-format
msgid "%s is not a regular file."
msgstr "%s ບໍ່ແມ່ນໄຟລ໌ປົກກະຕິ."

#: pluma/pluma-io-error-message-area.c:307
msgid "Connection timed out. Please try again."
msgstr "ໝົດເວລາການເຊື່ອມຕໍ່. ກະລຸນາລອງໃໝ່."

#: pluma/pluma-io-error-message-area.c:330
msgid "The file is too big."
msgstr "ໄຟລ໌ມີຂະໜາດໃຫຍ່ເກີນໄປ."

#: pluma/pluma-io-error-message-area.c:371
#, c-format
msgid "Unexpected error: %s"
msgstr "ຂໍ້ຜິດພາດທີ່ບໍ່ຄາດຄິດ: %s"

#: pluma/pluma-io-error-message-area.c:407
msgid "pluma cannot find the file. Perhaps it has recently been deleted."
msgstr "pluma ບໍ່ພົບໄຟລ໌. ບາງທີມັນອາດຈະຫາກໍຖືກລຶບອອກ."

#: pluma/pluma-io-error-message-area.c:417
#, c-format
msgid "Could not revert the file %s."
msgstr "ບໍ່ສາມາດຄືນຄ່າໄຟລ໌ %s ໄດ້."

#: pluma/pluma-io-error-message-area.c:443
msgid "Ch_aracter Encoding:"
msgstr "ການເຂົ້າລະຫັດຕົວອັກສອນ:"

#. Translators: the access key chosen for this string should be
#. different from other main menu access keys (Open, Edit, View...)
#: pluma/pluma-io-error-message-area.c:495
#: pluma/pluma-io-error-message-area.c:772
msgid "Edit Any_way"
msgstr "ຍັງຄົງແກ້ໄຂຕໍ່ໄປ"

#. Translators: the access key chosen for this string should be
#. different from other main menu access keys (Open, Edit, View...)
#: pluma/pluma-io-error-message-area.c:500
#: pluma/pluma-io-error-message-area.c:777
msgid "D_on't Edit"
msgstr "ບໍ່ຕ້ອງແກ້ໄຂ"

#: pluma/pluma-io-error-message-area.c:598
msgid ""
"The number of followed links is limited and the actual file could not be "
"found within this limit."
msgstr "ຈຳນວນການຕິດຕາມລິ້ງຄ໌ຖືກຈຳກັດ ແລະ ບໍ່ພົບໄຟລ໌ໃນຂອບເຂດນີ້."

#: pluma/pluma-io-error-message-area.c:602
msgid "You do not have the permissions necessary to open the file."
msgstr "ທ່ານບໍ່ມີສິດອະນຸຍາດໃນການເປີດໄຟລ໌ນີ້."

#: pluma/pluma-io-error-message-area.c:608
msgid "pluma has not been able to detect the character encoding."
msgstr "pluma ບໍ່ສາມາດກວດຫາລະຫັດຕົວອັກສອນໄດ້."

#: pluma/pluma-io-error-message-area.c:610
#: pluma/pluma-io-error-message-area.c:632
msgid "Please check that you are not trying to open a binary file."
msgstr "ກະລຸນາກວດສອບວ່າທ່ານບໍ່ໄດ້ພະຍາຍາມເປີດໄຟລ໌ໄບນາຣີ (binary)."

#: pluma/pluma-io-error-message-area.c:611
msgid "Select a character encoding from the menu and try again."
msgstr "ເລືອກລະຫັດຕົວອັກສອນຈາກເມນູແລ້ວລອງໃໝ່."

#: pluma/pluma-io-error-message-area.c:617
#, c-format
msgid "There was a problem opening the file %s."
msgstr "ເກີດບັນຫາໃນການເປີດໄຟລ໌ %s."

#: pluma/pluma-io-error-message-area.c:619
msgid ""
"The file you opened has some invalid characters. If you continue editing "
"this file you could make this document useless."
msgstr ""
"ໄຟລ໌ທີ່ທ່ານເປີດມີບາງຕົວອັກສອນທີ່ບໍ່ຖືກຕ້ອງ. ຫາກທ່ານຍັງແກ້ໄຂຕໍ່ໄປ ອາດເຮັດໃຫ້ເອກະສານເສຍຫາຍໄດ້."

#: pluma/pluma-io-error-message-area.c:622
msgid "You can also choose another character encoding and try again."
msgstr "ທ່ານສາມາດເລືອກລະຫັດຕົວອັກສອນອື່ນແລ້ວລອງໃໝ່."

#: pluma/pluma-io-error-message-area.c:629
#, c-format
msgid "Could not open the file %s using the %s character encoding."
msgstr "ບໍ່ສາມາດເປີດໄຟລ໌ %s ໂດຍໃຊ້ລະຫັດ %s ໄດ້."

#: pluma/pluma-io-error-message-area.c:633
#: pluma/pluma-io-error-message-area.c:708
msgid "Select a different character encoding from the menu and try again."
msgstr "ເລືອກລະຫັດຕົວອັກສອນອື່ນຈາກເມນູແລ້ວລອງໃໝ່."

#: pluma/pluma-io-error-message-area.c:643
#, c-format
msgid "Could not open the file %s."
msgstr "ບໍ່ສາມາດເປີດໄຟລ໌ %s ໄດ້."

#: pluma/pluma-io-error-message-area.c:703
#, c-format
msgid "Could not save the file %s using the %s character encoding."
msgstr "ບໍ່ສາມາດບັນທຶກໄຟລ໌ %s ດ້ວຍລະຫັດ %s ໄດ້."

#: pluma/pluma-io-error-message-area.c:706
msgid ""
"The document contains one or more characters that cannot be encoded using "
"the specified character encoding."
msgstr "ເອກະສານມີບາງຕົວອັກສອນທີ່ບໍ່ສາມາດເຂົ້າລະຫັດດ້ວຍລະຫັດທີ່ລະບຸໄດ້."

#: pluma/pluma-io-error-message-area.c:792
#, c-format
msgid "This file (%s) is already open in another pluma window."
msgstr "ໄຟລ໌ນີ້ (%s) ຖືກເປີດຢູ່ແລ້ວໃນໜ້າຕ່າງ pluma ອື່ນ."

#: pluma/pluma-io-error-message-area.c:806
msgid ""
"pluma opened this instance of the file in a non-editable way. Do you want to "
"edit it anyway?"
msgstr "pluma ເປີດໄຟລ໌ນີ້ໃນໂໝດທີ່ແກ້ໄຂບໍ່ໄດ້. ທ່ານຍັງຕ້ອງການແກ້ໄຂມັນຫຼືບໍ່?"

#: pluma/pluma-io-error-message-area.c:865
#: pluma/pluma-io-error-message-area.c:963
msgid "S_ave Anyway"
msgstr "ຍັງຄົງບັນທຶກຕໍ່ໄປ"

#: pluma/pluma-io-error-message-area.c:869
#: pluma/pluma-io-error-message-area.c:967
msgid "D_on't Save"
msgstr "ບໍ່ຕ້ອງບັນທຶກ"

#: pluma/pluma-io-error-message-area.c:887
#, c-format
msgid "The file %s has been modified since reading it."
msgstr "ໄຟລ໌ %s ຖືກແກ້ໄຂແລ້ວຫຼັງຈາກທີ່ທ່ານອ່ານມັນ."

#: pluma/pluma-io-error-message-area.c:902
msgid "If you save it, all the external changes could be lost. Save it anyway?"
msgstr "ຫາກທ່ານບັນທຶກ, ການປ່ຽນແປງຈາກພາຍນອກຈະຫາຍໄປ. ຍັງຄົງບັນທຶກຕໍ່ໄປຫຼືບໍ່?"

#: pluma/pluma-io-error-message-area.c:990
#, c-format
msgid "Could not create a backup file while saving %s"
msgstr "ບໍ່ສາມາດສ້າງໄຟລ໌ສຳຮອງໃນຂະນະທີ່ບັນທຶກ %s ໄດ້"

#: pluma/pluma-io-error-message-area.c:993
#, c-format
msgid "Could not create a temporary backup file while saving %s"
msgstr "ບໍ່ສາມາດສ້າງໄຟລ໌ສຳຮອງຊົ່ວຄາວໃນຂະນະທີ່ບັນທຶກ %s ໄດ້"

#: pluma/pluma-io-error-message-area.c:1009
msgid ""
"pluma could not back up the old copy of the file before saving the new one. "
"You can ignore this warning and save the file anyway, but if an error occurs "
"while saving, you could lose the old copy of the file. Save anyway?"
msgstr "pluma ບໍ່ສາມາດສຳຮອງໄຟລ໌ເກົ່າໄດ້. ທ່ານຕ້ອງການບັນທຶກຕໍ່ໄປຫຼືບໍ່?"

#. Translators: %s is a URI scheme (like for example http:, ftp:, etc.)
#: pluma/pluma-io-error-message-area.c:1069
#, c-format
msgid ""
"pluma cannot handle %s locations in write mode. Please check that you typed "
"the location correctly and try again."
msgstr "pluma ບໍ່ຮອງຮັບທີ່ຢູ່ %s ໃນໂໝດການຂຽນ."

#: pluma/pluma-io-error-message-area.c:1077
msgid ""
"pluma cannot handle this location in write mode. Please check that you typed "
"the location correctly and try again."
msgstr "pluma ບໍ່ຮອງຮັບທີ່ຢູ່ນີ້ໃນໂໝດການຂຽນ."

#: pluma/pluma-io-error-message-area.c:1086
#, c-format
msgid ""
"%s is not a valid location. Please check that you typed the location "
"correctly and try again."
msgstr "%s ແມ່ນທີ່ຢູ່ທີ່ບໍ່ຖືກຕ້ອງ. ກະລຸນາກວດສອບການພິມທີ່ຢູ່ຂອງທ່ານ."

#: pluma/pluma-io-error-message-area.c:1092
msgid ""
"You do not have the permissions necessary to save the file. Please check "
"that you typed the location correctly and try again."
msgstr "ທ່ານບໍ່ມີສິດໃນການບັນທຶກໄຟລ໌ນີ້."

#: pluma/pluma-io-error-message-area.c:1098
msgid ""
"There is not enough disk space to save the file. Please free some disk space "
"and try again."
msgstr "ພື້ນທີ່ວ່າງໃນດິສກ໌ບໍ່ພຽງພໍທີ່ຈະບັນທຶກໄຟລ໌."

#: pluma/pluma-io-error-message-area.c:1103
msgid ""
"You are trying to save the file on a read-only disk. Please check that you "
"typed the location correctly and try again."
msgstr "ທ່ານກຳລັງບັນທຶກໄຟລ໌ລົງໃນດິສກ໌ທີ່ອ່ານໄດ້ຢ່າງດຽວ."

#: pluma/pluma-io-error-message-area.c:1109
msgid "A file with the same name already exists. Please use a different name."
msgstr "ມີໄຟລ໌ຊື່ນີ້ຢູ່ແລ້ວ. ກະລຸນາໃຊ້ຊື່ອື່ນ."

#: pluma/pluma-io-error-message-area.c:1114
msgid ""
"The disk where you are trying to save the file has a limitation on length of "
"the file names. Please use a shorter name."
msgstr "ດິສກ໌ນີ້ມີການຈຳກັດຄວາມຍາວຂອງຊື່ໄຟລ໌. ກະລຸນາໃຊ້ຊື່ທີ່ສັ້ນກວ່າ."

#: pluma/pluma-io-error-message-area.c:1121
msgid ""
"The disk where you are trying to save the file has a limitation on file "
