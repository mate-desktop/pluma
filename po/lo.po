msgstr "ປະຕິບັດຄຳສັ່ງທີ່ກຳນົດເອງ ແລະ ເອົາຜົນອອກໄປໃສ່ໃນເອກະສານໃໝ່"

#: plugins/externaltools/data/search-recursive.desktop.in:2
msgid "Search"
msgstr "ຄົ້ນຫາ"

#: plugins/externaltools/data/switch-c.desktop.in:2
msgid "Switch onto a file .c and .h"
msgstr "ສະຫລັບລະຫວ່າງແຟ້ມ .c ແລະ .h"

#: plugins/filebrowser/filebrowser.plugin.desktop.in.in:5
msgid "File Browser Pane"
msgstr "ແຖບຕົວທ່ອງແຟ້ມ"

#: plugins/filebrowser/filebrowser.plugin.desktop.in.in:6
msgid "Easy file access from the side pane"
msgstr "ເຂົ້າເຖິງແຟ້ມໄດ້ງ່າຍຈາກແຖບຂ້າງ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:6
msgid "Set Location to First Document"
msgstr "ຕັ້ງທີ່ຕັ້ງໄປຫາເອກະສານທຳອິດ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:7
msgid ""
"If TRUE the file browser plugin will view the directory of the first opened "
"document given that the file browser hasn't been used yet. (Thus this "
"generally applies to opening a document from the command line or opening it "
"with Caja, etc.)"
msgstr ""
"ຖ້າເປັນ ຈິງ ປລັກອິນຕົວທ່ອງເວັບໄຟລ໌ຈະສະແດງໂຟນເດີຂອງເອກະສານທຳອິດທີ່ຖືກເປີດ ໂດຍມີເງື່ອນໄຂວ່າຕົວທ່ອງເວັ"
"ບໄຟລ໌ນັ້ນຍັງບໍ່ທັນໄດ້ຖືກນຳໃຊ້ເທື່ອ. (ດັ່ງນັ້ນ ໂດຍທົ່ວໄປແລ້ວສິ່ງນີ້ຈະນຳໃຊ້ກັບການເປີດເອກະສານຈາກບັນທັດຄຳສັ່ງ "
"ຫຼື ເປີດດ້ວຍ Caja, ແລະ ອື່ນໆ.)"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:11
msgid "File Browser Filter Mode"
msgstr "ໂໝດການກອງຂອງຕົວທ່ອງແຟ້ມ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:12
msgid ""
"This value determines what files get filtered from the file browser. Valid "
"values are: none (filter nothing), hidden (filter hidden files), binary "
"(filter binary files) and hidden_and_binary (filter both hidden and binary "
"files)."
msgstr ""
"ຄ່ານີ້ກຳນົດວ່າແຟ້ມໃດຈະຖືກກອງອອກຈາກຕົວທ່ອງແຟ້ມ. ຄ່າທີ່ໃຊ້ໄດ້ແມ່ນ: none, hidden, binary ແລະ "
"hidden_and_binary."

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:16
msgid "File Browser Filter Pattern"
msgstr "ຮູບແບບການກອງຂອງຕົວທ່ອງແຟ້ມ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:17
msgid ""
"The filter pattern to filter the file browser with. This filter works on top "
"of the filter_mode."
msgstr "ຮູບແບບການກອງທີ່ໃຊ້ກັບຕົວທ່ອງແຟ້ມ."

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:24
msgid "Open With Tree View"
msgstr "ເປີດດ້ວຍມຸມມອງແບບຕົ້ນໄມ້"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:25
msgid ""
"Open the tree view when the file browser plugin gets loaded instead of the "
"bookmarks view"
msgstr ""
"ເປີດມຸມມອງແບບຕົ້ນໄມ້ເມື່ອໂຫລດປລັກອິນຕົວທ່ອງແຟ້ມ ແທນທີ່ຈະເປັນມຸມມອງບຸກມາກ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:29
msgid "File Browser Root Directory"
msgstr "ໄດເຣັກທໍຣີຮາກຂອງຕົວທ່ອງແຟ້ມ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:30
msgid ""
"The file browser root directory to use when loading the file browser plugin "
"and onload/tree_view is TRUE."
msgstr "ໄດເຣັກທໍຣີຮາກທີ່ຈະໃຊ້ເມື່ອໂຫລດປລັກອິນຕົວທ່ອງແຟ້ມ."

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:34
msgid "File Browser Virtual Root Directory"
msgstr "ໄດເຣັກທໍຣີຮາກສະເມືອນຂອງຕົວທ່ອງແຟ້ມ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:35
msgid ""
"The file browser virtual root directory to use when loading the file browser "
"plugin when onload/tree_view is TRUE. The virtual root must always be below "
"the actual root."
msgstr "ໄດເຣັກທໍຣີຮາກສະເມືອນທີ່ຈະໃຊ້ເມື່ອໂຫລດປລັກອິນຕົວທ່ອງແຟ້ມ."

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:39
msgid "Enable Restore of Remote Locations"
msgstr "ເປີດໃຊ້ການຄືນຄ່າທີ່ຕັ້ງທາງໄກ"

#: plugins/filebrowser/org.mate.pluma.plugins.filebrowser.gschema.xml.in:40
msgid "Sets whether to enable restoring of remote locations."
msgstr "ກຳນົດວ່າຈະເປີດໃຊ້ການຄືນຄ່າທີ່ຕັ້ງທາງໄກຫຼືບໍ່."

